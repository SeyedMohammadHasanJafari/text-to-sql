# ─────────────────────────────────────────────────────────────────────────────
# Shared by docker compose AND the API server. Copy to `.env` and change every
# secret. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL superuser (used ONLY by docker + `npm run db:bootstrap`) ──────
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# ── Application roles (created by `npm run db:bootstrap` from these URLs) ────
# app_admin: owns the system schema and sandboxes. Trusted SQL only.
DATABASE_URL=postgres://app_admin:change-me-admin@localhost:5432/text_to_sql
# readonly_agent: executes AI-generated SQL. Holds no privileges of its own.
AGENT_DATABASE_URL=postgres://readonly_agent:change-me-agent@localhost:5432/text_to_sql

# ── API server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
SESSION_TTL_HOURS=12

# ── Sandbox limits for AI-generated queries ──────────────────────────────────
SANDBOX_STATEMENT_TIMEOUT_MS=5000
SANDBOX_MAX_ROWS=500

# ── AI Engine (Aval AI or OpenAI / Claude compatible) ────────────────────────
# Get your API key from https://avalai.ir or OpenAI
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.avalai.ir/v1
AI_MODEL=gpt-4o-mini
