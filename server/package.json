{
  "name": "text-to-sql-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the Chat-with-Your-Data Text-to-SQL agent.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#db/*": "./src/db/*",
    "#lib/*": "./src/lib/*",
    "#middleware/*": "./src/middleware/*",
    "#modules/*": "./src/modules/*",
    "#sandbox/*": "./src/sandbox/*"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:bootstrap": "node db/scripts/bootstrap.js",
    "db:migrate": "node db/scripts/migrate.js",
    "db:verify-sandbox": "node db/scripts/verify-sandbox.js",
    "test": "node --test"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
